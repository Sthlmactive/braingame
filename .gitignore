# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw upstream word sources. Re-fetch with `npm run data:fetch`; saldom.xml
# alone is 254 MB and is never committed. The built data in public/data is.
/scripts/.cache/

# Clue-pipeline working files. Regenerated by scripts/fix-clues.ts and
# scripts/repair-clues.ts on every run; the bank itself is committed.
/data/clues/needs-regeneration.json
/data/clues/still-failing.json

# Third-party agent skills, installed with `npx skills add`. Tooling, not
# product code, and they run with full agent permissions — kept out of the
# repo deliberately.
/.agents/skills/
# …and the rest of what `npx skills add` writes: symlinks into the directory
# above, and its lockfile.
/.claude/skills/
/skills-lock.json
